# =============================================
# AI Career OS — Backend Environment Variables
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!

PORT=5000

# === Database (Supabase PostgreSQL) ===
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# === Supabase Auth ===
SUPABASE_URL="https://[REF].supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
JWT_SECRET=your-random-64-char-hex-string

# === AI Configuration ===
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODELS=gemini-2.5-flash

# OpenRouter (optional multi-model support)
USE_OPENROUTER=true
OPENROUTER_API_KEY=sk-or-v1-your-key
DEFAULT_FREE_MODEL=google/gemini-2.5-flash
DEFAULT_PRO_MODEL=google/gemini-2.5-pro

# === Redis / Upstash ===
# Local dev: comment out to use localhost:6379
# Production: use Upstash rediss:// URL
REDIS_URL="rediss://default:your-upstash-token@your-endpoint.upstash.io:6379"

# === Razorpay Payments (optional) ===
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx

# === CORS ===
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
ALLOWED_ORIGINS="http://localhost:3000"
